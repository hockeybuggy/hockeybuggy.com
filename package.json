{
  "name": "hockeybuggy.com",
  "description": "The personal website of Douglas Anderson",
  "version": "1.0.0",
  "author": "Douglas Anderson",
  "repository": "git@github.com:hockeybuggy/hockeybuggy.com.git",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "cargo run --release --manifest-path ssg/Cargo.toml",
    "dev": "node dev_server.js",
    "start": "node serve_static.js",
    "test:e2e": "playwright test",
    "preview:cloudflare": "yarn build && wrangler dev --local --ip 127.0.0.1",
    "deploy:cloudflare": "yarn build && wrangler deploy",
    "test:cloudflare": "node --test cloudflare_tests/config.test.cjs && playwright test --config playwright.cloudflare.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.6.0",
    "dotenv": "^18.0.1",
    "typescript": "^7.0.2",
    "wrangler": "4.136.1"
  },
  "packageManager": "yarn@4.5.0"
}

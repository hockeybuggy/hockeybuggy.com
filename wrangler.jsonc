{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hockeybuggy",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
